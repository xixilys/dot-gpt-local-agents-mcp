    }
  },
  {
    "name": "list_agents",
    "title": "List agents",
    "description": "List recent agents as compact metadata.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "includeArchived": {
          "default": false,
          "type": "boolean"
        },
        "cwd": {
          "type": "string"
        },
        "sinceHours": {
          "default": 48,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 720
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "initializing",
              "idle",
              "running",
              "error",
              "closed"
            ]
          }
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200
        }
      }
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
