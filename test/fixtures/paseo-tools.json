                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                }
              },
              "required": [
                "behavior"
              ]
            },
            {
              "type": "object",
              "properties": {
                "behavior": {
                  "type": "string",
                  "const": "deny"
                },
                "selectedActionId": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "interrupt": {
