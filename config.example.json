{
  "publicBaseUrl": "https://gateway.example.com",
  "port": 6768,
  "upstreamUrl": "http://127.0.0.1:6767/mcp/agents",
  "stateDir": "/absolute/path/to/home/.local/share/local-agents-mcp",
  "ownerTokenFile": "/absolute/path/to/private/owner.json",
  "paseoCommand": "/absolute/path/to/paseo",
  "allowedRoots": [
    "/absolute/path/to/allowed/project"
  ],
  "hosts": [
    {
      "id": "wsl",
      "name": "WSL",
      "transport": "ssh",
      "target": "ssh://linux-host",
      "allowedRoots": [
        "/home/you/project"
      ],
      "remoteStateDir": "/home/you/.local-agents-mcp-bridge/gateway",
      "direct": {
        "projects": [
          {
            "id": "remote-project",
            "name": "Remote project",
            "path": "/home/you/project",
            "read": true,
            "write": false,
            "commandMode": "registered",
            "commands": [
              {
                "name": "working-directory",
                "argv": [
                  "pwd"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "direct": {
    "projects": [
      {
        "id": "local-project",
        "name": "Local project",
        "path": "/absolute/path/to/allowed/project",
        "read": true,
        "write": false,
        "commandMode": "registered",
        "commands": [
          {
            "name": "working-directory",
            "argv": [
              "pwd"
            ]
          }
        ]
      }
    ]
  }
}
